# Which weather data source the app uses.
#   open-meteo  Live data from Open-Meteo (free, no API key). Default.
#   mock        Built-in sample data for five cities; works offline.
VITE_WEATHER_PROVIDER=open-meteo

# Reserved for providers that need a key (for example OpenWeatherMap or WeatherAPI.com).
# Anything prefixed VITE_ is bundled into the browser code, so a production key
# should live behind your own server or proxy instead. See README.
# VITE_WEATHER_API_KEY=
